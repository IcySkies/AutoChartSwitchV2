<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Icon.ico" />
    <Resource Include="Assets\TechStats\Original\*.png" />
    <Content Include="..\..\Memories_Sacrifice_jacket.png" Link="Memories_Sacrifice_jacket.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoChartSwitch.Core\AutoChartSwitch.Core.csproj" />
    <ProjectReference Include="..\AutoChartSwitch.GameBridge\AutoChartSwitch.GameBridge.csproj" />
    <ProjectReference Include="..\AutoChartSwitch.Obs\AutoChartSwitch.Obs.csproj" />
    <ProjectReference Include="..\..\..\In-gameInfoAPI\VividStasisGameInfoRelay\VividStasisGameInfoRelay.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <Target Name="CopyRelay" AfterTargets="Build">
    <ItemGroup>
      <RelayFiles Include="$(MSBuildProjectDirectory)\..\..\..\In-gameInfoAPI\VividStasisGameInfoRelay\bin\$(Configuration)\net8.0-windows\VividStasisGameInfoRelay.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RelayFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishRelay" AfterTargets="Publish">
    <ItemGroup>
      <RelayFiles Include="$(MSBuildProjectDirectory)\..\..\..\In-gameInfoAPI\VividStasisGameInfoRelay\bin\$(Configuration)\net8.0-windows\VividStasisGameInfoRelay.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RelayFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
